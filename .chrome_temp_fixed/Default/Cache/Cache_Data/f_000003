  /* Modal Management with Spring Physics */
  function openModal(html) {
    const box = $('#modal-box');
    const backdrop = $('#modal-backdrop');
    box.innerHTML = html;
    backdrop.classList.add('show');

    if (window.anime) {
      anime({
        targets: box,
        scale: [0.88, 1],
        opacity: [0, 1],
        translateY: [16, 0],
        duration: 350,
        easing: 'easeOutQuint'
      });
    }

    const firstInput = $('#modal-box input, #modal-box select');
    if (firstInput) setTimeout(() => firstInput.focus(), 120);
  }

  function closeModal() {
    const box = $('#modal-box');
    const backdrop = $('#modal-backdrop');
    if (window.anime) {
      anime({
        targets: box,
        scale: [1, 0.94],
        opacity: [1, 0],
        duration: 200,
        easing: 'easeInQuad',
        complete: () => backdrop.classList.remove('show')
      });
    } else {
      backdrop.classList.remove('show');
    }
  }

  /* Keyboard shortcut handling */
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      closeModal();
      closeDrawer();
    }
  });

  /* Real-time Clock */
  function startClock() {
    const update = () => {
      const now = new Date();
      const str = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      const clockEl = $('#top-clock');
      if (clockEl) clockEl.textContent = str;
    };
    update();
    setInterval(update, 1000);
  }

  /* ================= SKELETON TABLE PLACEHOLDER ================= */
  function renderTableSkeleton(tableSelector, cols = 6, rows = 6) {
    const table = $(tableSelector);
    if (!table) return;
    table.innerHTML = `
      <thead>
        <tr>${Array(cols).fill('<th><div class="skeleton-shimmer" style="height:14px;width:70%"></div></th>').join('')}</tr>
      </thead>
      <tbody>
        ${Array(rows).fill(`<tr>${Array(cols).fill('<td><div class="skeleton-shimmer" style="height:16px;width:80%"></div></td>').join('')}</tr>`).join('')}
      </tbody>
    `;
  }

  /* ================= 04. ANIME.JS CHOREOGRAPHY ENGINE ================= */
  function animateHeaderLotus() {
    if (!window.anime) return;
    const visual = $('#hero-lotus-visual');
    if (!visual) return;

    // Stroke drawing and breathing animation
    anime({
      targets: '.lotus-ring-inner',
      rotate: '1turn',
      duration: 32000,
      loop: true,
      easing: 'linear'
    });

    anime({
      targets: '.lotus-ring-outer',
      rotate: '-1turn',
      duration: 48000,
      loop: true,
      easing: 'linear'
    });

    anime({
      targets: '.lotus-petal',
      strokeDashoffset: [anime.setDashoffset, 0],
      easing: 'easeInOutSine',
      duration: 1800,
      delay: (el, i) => i * 90
    });
  }

  function animateNumberCounter(el, targetVal, isCurrency = true) {
    if (!window.anime) {
      el.textContent = isCurrency ? fmt(targetVal) : num(targetVal);
      return;
    }
    const obj = { val: 0 };
    anime({
      targets: obj,
      val: targetVal,
      round: 1,
      duration: 1200,
      easing: 'easeOutExpo',
      update: () => {
        el.textContent = isCurrency ? fmt(obj.val) : num(obj.val);
      }
    });
  }

