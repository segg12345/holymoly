  /* Toast Notification System with Anime.js */
  function toast(message, isError = false) {
    let container = $('#toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'toast-container';
      document.body.appendChild(container);
    }
    
    const pill = document.createElement('div');
    pill.className = `toast-pill ${isError ? 'err' : ''}`;
    pill.innerHTML = `
      <div class="toast-icon">${isError ? ICONS.alert : ICONS.check}</div>
      <div style="flex:1">${esc(message)}</div>
    `;
    container.appendChild(pill);

    if (window.anime) {
      anime({
        targets: pill,
        translateY: [24, 0],
        opacity: [0, 1],
        scale: [0.94, 1],
        duration: 380,
        easing: 'easeOutElastic(1, 0.75)'
      });
    } else {
      pill.classList.add('show');
    }

    setTimeout(() => {
      if (window.anime) {
        anime({
          targets: pill,
          translateY: [0, -16],
          opacity: [1, 0],
          duration: 250,
          easing: 'easeInQuad',
          complete: () => pill.remove()
        });
      } else {
        pill.classList.remove('show');
        setTimeout(() => pill.remove(), 260);
      }
    }, isError ? 4500 : 2800);
  }

  /* API Client */
  async function api(url, options = {}) {
    const config = {
      headers: { 'Content-Type': 'application/json' },
      ...options,
      body: options.body ? JSON.stringify(options.body) : undefined
    };
    try {
      const res = await fetch('/api' + url, config);
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(data.error || `Lỗi máy chủ (${res.status})`);
      }
      return data;
    } catch (err) {
      console.error(`API Error on ${url}:`, err);
      throw err;
    }
  }

