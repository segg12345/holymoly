    let filtered = ALL_DATBAN;
    if (statusFilter) {
      filtered = filtered.filter(x => x.TrangThai === statusFilter);
    }
    if (q) {
      filtered = filtered.filter(x => 
        (x.TenKhach && x.TenKhach.toLowerCase().includes(q)) ||
        (x.SoDienThoai && x.SoDienThoai.includes(q)) ||
        (x.TenBan && x.TenBan.toLowerCase().includes(q)) ||
        (x.GhiChu && x.GhiChu.toLowerCase().includes(q))
      );
    }

    const badge = $('#db-count-badge');
    if (badge) badge.textContent = `${filtered.length} lượt đặt`;

    const container = $('#datban-table');
    if (!container) return;

    if (!filtered.length) {
      container.innerHTML = `<tr><td colspan="7" class="empty-state"><p class="empty-state-desc">Không tìm thấy lịch đặt bàn nào phù hợp</p></td></tr>`;
      return;
