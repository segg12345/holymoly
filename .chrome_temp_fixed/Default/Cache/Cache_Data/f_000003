      </thead>
      <tbody>
        ${items.map(x => `
          <tr>
            <td>
              <div style="font-weight:600;color:var(--status-bad)">${esc(x.TenNL)}</div>
            </td>
            <td class="num"><b style="color:var(--status-bad)">${num(x.SoLuongTon)} ${x.DonViTinh}</b></td>
            <td class="num">${num(x.MucToiThieu)}</td>
            <td class="num"><b style="color:var(--gold-700)">+ ${num(x.SoLuongCanNhap)}</b></td>
          </tr>
        `).join('')}
      </tbody>
    `;
  }

  /* ================= 2. SƠ ĐỒ BÀN & POS ================= */
  async function loadBan() {
    try {
      BAN = await api('/ban');
      await ensureRefs();

      const zones = ['ALL', ...new Set(BAN.map(b => b.KhuVuc))];
      const toolbar = $('#zone-filter-bar');
      
      // Render Zone filter tabs with counts
      toolbar.innerHTML = `
        <div class="zone-tabs">
          ${zones.map(z => {
            const count = z === 'ALL' ? BAN.length : BAN.filter(b => b.KhuVuc === z).length;
            const label = z === 'ALL' ? 'Tất cả khu vực' : z;
            return `
              <button class="zone-tab-btn ${ACTIVE_ZONE === z ? 'active' : ''}" onclick="window.app.setZone('${z}')">
                <span>${esc(label)}</span>
                <span class="zone-tab-count">${count}</span>
              </button>
            `;
          }).join('')}
        </div>

        <div class="floor-legend">
          <div class="legend-item"><span class="legend-dot" style="background:var(--status-ok)"></span> Trống</div>
          <div class="legend-item"><span class="legend-dot" style="background:var(--status-busy)"></span> Đang phục vụ</div>
          <div class="legend-item"><span class="legend-dot" style="background:var(--status-book)"></span> Đã đặt</div>
        </div>
      `;

      renderFloorPlan();

    } catch (err) {
      toast(err.message, true);
    }
  }

  function setZone(z) {
    ACTIVE_ZONE = z;
    $$('.zone-tab-btn').forEach(btn => {
      const match = btn.textContent.includes(z === 'ALL' ? 'Tất cả' : z);
      btn.classList.toggle('active', match);
    });
    renderFloorPlan();
  }

  function renderFloorPlan() {
    const floorEl = $('#floor-container');
    const filteredBan = ACTIVE_ZONE === 'ALL' ? BAN : BAN.filter(b => b.KhuVuc === ACTIVE_ZONE);
    const zonesToRender = ACTIVE_ZONE === 'ALL' ? [...new Set(BAN.map(b => b.KhuVuc))] : [ACTIVE_ZONE];

    floorEl.innerHTML = zonesToRender.map(z => {
      const tablesInZone = filteredBan.filter(b => b.KhuVuc === z);
      const busyCount = tablesInZone.filter(b => b.TrangThai === 'Đang phục vụ').length;

      return `
        <div class="zone-section">
          <div class="zone-header">
            <h3>${esc(z)}</h3>
            <span class="occupancy-pill">${busyCount} / ${tablesInZone.length} bàn đang có khách (${Math.round((busyCount / (tablesInZone.length || 1)) * 100)}%)</span>
          </div>

          <div class="tables-grid">
            ${tablesInZone.map(b => {
              const isOpen = b.TrangThai === 'Đang phục vụ';
              const isBooked = b.TrangThai === 'Đã đặt';
              const statusClass = tagTT(b.TrangThai);

              // Seat pips
              const pips = Array.from({ length: b.SoCho }, () => '<span class="seat-pip"></span>').join('');

              return `
                <div class="table-card ${statusClass}" onclick="window.app.clickBan(${b.MaBan})">
                  <div class="table-card-top">
                    <div>
                      <div class="table-code">${esc(b.TenBan)}</div>
                      <div class="table-seats-row" title="${b.SoCho} chỗ ngồi">${pips}</div>
                    </div>
                    ${tag(b.TrangThai)}
                  </div>

                  <div class="table-card-body">
                    ${isOpen ? `
                      <div class="table-time-badge">
                        ${ICONS.clock} ${b.SoPhutDaNgoi} phút
                      </div>
                      <div class="table-card-total tabular">${fmt(b.TongTien)}</div>
                      <div style="font-size:11.5px;color:var(--text-muted);margin-top:2px">HĐ #${b.MaHD} · ${esc(b.TenKhach || 'Khách lẻ')}</div>
                    ` : (isBooked ? `
                      <div style="color:var(--status-book);font-weight:600">Có khách đặt hôm nay</div>
                      <div style="font-size:11.5px;color:var(--text-muted);margin-top:2px">${b.SoCho} chỗ ngồi</div>
                    ` : `
                      <div style="color:var(--status-ok);font-weight:500">Sẵn sàng đón khách</div>
                      <div style="font-size:11.5px;color:var(--text-muted);margin-top:2px">${b.SoCho} chỗ ngồi</div>
                    `)}
                  </div>

                  <div class="table-card-action">
                    <span>${isOpen ? 'Chi tiết & Thêm món' : 'Mở bàn mới'}</span>
                    <span style="font-size:14px">→</span>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }).join('');

    // Staggered Table Animation
    if (window.anime) {
      anime({
        targets: '.table-card',
        translateY: [24, 0],
        opacity: [0, 1],
        duration: 400,
        delay: anime.stagger(28),
        easing: 'easeOutQuint'
      });
    }
  }

  function clickBan(maBan) {
    const b = BAN.find(x => x.MaBan === maBan);
    if (!b) return;
    if (b.MaHD) {
      openDrawer(b.MaHD);
    } else {
      openMoHoaDon(b);
    }
  }

  function openMoHoaDon(b) {
    openModal(`
      <div class="modal-header">
        <h2>Mở bàn &amp; Hóa đơn — ${esc(b.TenBan)}</h2>
        <button class="close-btn" onclick="window.app.closeModal()">${ICONS.close}</button>
      </div>
      <div class="modal-body">
        <div class="field">
          <label>Khu vực &amp; Số chỗ ngồi</label>
          <input type="text" disabled value="${esc(b.KhuVuc)} · Bàn ${b.SoCho} chỗ" style="background:var(--canvas-subtle)">
        </div>

        <div class="field">
          <label>Nhân viên phục vụ <span style="color:var(--status-bad)">*</span></label>
          <select id="m-nv" class="input-box">
            ${NV.map(n => `<option value="${n.MaNV}">${esc(n.HoTen)} (${n.ChucVu})</option>`).join('')}
          </select>
        </div>

        <div class="field">
          <label>Khách hàng thành viên (tùy chọn)</label>
          <div class="input-with-icon">
            ${ICONS.search}
            <input id="m-kh" placeholder="Nhập SĐT hoặc tên để tìm khách..." oninput="window.app.timKhach()" autocomplete="off">
          </div>
          <div id="m-kh-results" style="margin-top:8px"></div>
          <input type="hidden" id="m-kh-id">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn ghost" onclick="window.app.closeModal()">Đóng</button>
        <button class="btn primary" onclick="window.app.submitMoHoaDon(${b.MaBan})">
          ${ICONS.plus} Mở hóa đơn ngay
        </button>
      </div>
    `);
  }

  const timKhach = debounce(async () => {
    const q = $('#m-kh').value.trim();
    const resultBox = $('#m-kh-results');
    if (q.length < 2) {
      resultBox.innerHTML = '';
      return;
    }
    try {
      const list = await api('/khachhang?q=' + encodeURIComponent(q));
      if (!list.length) {
        resultBox.innerHTML = '<div style="font-size:12px;color:var(--text-muted)">Không tìm thấy khách hàng nào khớp</div>';
        return;
      }
      resultBox.innerHTML = list.slice(0, 4).map(k => `
        <button class="btn sm" style="margin:4px 4px 0 0" type="button"
          onclick="window.app.selectKhach(${k.MaKH}, '${esc(k.HoTen)}', '${k.SoDienThoai}', '${k.HangThanhVien}')">
          <b>${esc(k.HoTen)}</b> · ${k.SoDienThoai} (${k.HangThanhVien})
        </button>
      `).join('');
    } catch (err) {
      console.error(err);
    }
  });

  function selectKhach(id, hoTen, sdt, hang) {
    $('#m-kh').value = `${hoTen} (${sdt}) - ${hang}`;
    $('#m-kh-id').value = id;
    $('#m-kh-results').innerHTML = '';
  }

  async function submitMoHoaDon(maBan) {
    try {
      const maNV = Number($('#m-nv').value);
      const maKH = $('#m-kh-id').value ? Number($('#m-kh-id').value) : null;
      const res = await api('/hoadon', {
        method: 'POST',
        body: { maBan, maNV, maKH }
      });
      closeModal();
      toast('Đã mở thành công hóa đơn #' + res.maHD);
      await loadBan();
      openDrawer(res.maHD);
    } catch (err) {
      toast(err.message, true);
    }
  }

  /* ================= 3. POS DRAWER & CHECKOUT ================= */
  async function openDrawer(maHD) {
    try {
      if (!MENU.length) MENU = await api('/monan');
      const r = await api('/hoadon/' + maHD);
      CUR_HD = r;
      const h = r.hoaDon;
      const isOpen = h.TrangThai === 'Đang phục vụ';

      $('#d-title').innerHTML = `<span>${esc(h.TenBan)}</span> <small style="font-size:15px;color:var(--text-muted);font-weight:500">HĐ #${h.MaHD}</small>`;
      $('#d-meta').innerHTML = `
        ${tag(h.TrangThai)}
        <span><b>Khách:</b> ${esc(h.TenKhach)}</span>
        <span>· <b>NV:</b> ${esc(h.NhanVien)}</span>
        <span>· ${dt(h.ThoiGianLap)}</span>
      `;

      // Drawer Body
      $('#d-body').innerHTML = `
        ${isOpen ? `
          <div class="add-dish-panel">
            <div class="add-dish-panel-title">Thêm món vào bàn</div>
            <div class="add-dish-controls">
              <select id="d-mon" class="input-box" style="flex:2">
                ${DM.map(c => `
                  <optgroup label="${esc(c.TenDM)}">
                    ${MENU.filter(m => m.MaDM === c.MaDM).map(m => `
                      <option value="${m.MaMon}">${esc(m.TenMon)} — ${fmt(m.DonGia)}</option>
                    `).join('')}
                  </optgroup>
                `).join('')}
              </select>
              <input type="number" id="d-sl" value="1" min="1" max="50" class="input-box" style="width:72px" title="Số lượng">
              <button class="btn primary" onclick="window.app.themMon()" title="Thêm món">
                ${ICONS.plus} Thêm
              </button>
            </div>
          </div>
        ` : ''}

        <div style="display:flex;align-items:center;justify-content:space-between">
          <h4 style="font-family:var(--font-display);font-size:16px;font-weight:700;color:var(--green-950)">Chi tiết món đã gọi (${r.chiTiet.length})</h4>
          <button class="btn ghost sm" onclick="window.app.printReceiptModal()">
            ${ICONS.print} In hóa đơn
          </button>
        </div>

        <div class="order-items-ticket" id="order-ticket">
          ${r.chiTiet.length ? r.chiTiet.map(c => `
            <div class="ticket-row" id="dish-row-${c.MaMon}">
              <div class="ticket-item-main">
                <div class="ticket-item-name">${esc(c.TenMon)}</div>
                <div class="ticket-item-sub">${fmt(c.DonGia)} / ${esc(c.DonViTinh || 'Phần')} ${c.GhiChu ? `· <i>${esc(c.GhiChu)}</i>` : ''}</div>
              </div>
              <span class="ticket-qty-pill">x${c.SoLuong}</span>
              <span class="ticket-item-price tabular">${fmt(c.ThanhTien)}</span>
              ${isOpen ? `
                <button class="btn ghost sm danger" style="padding:4px" onclick="window.app.xoaMon(${c.MaMon})" title="Xóa món">
                  ${ICONS.trash}
                </button>
              ` : ''}
            </div>
          `).join('') : `
            <div class="empty-state" style="padding:28px 16px">
              <p class="empty-state-desc">Bàn này chưa gọi món ăn nào</p>
            </div>
          `}
        </div>

        ${r.nhatKy && r.nhatKy.length ? `
          <div style="margin-top:14px">
            <h4 style="font-size:13px;font-weight:700;color:var(--text-muted);margin-bottom:8px">Nhật ký xử lý</h4>
            <div style="background:var(--canvas-subtle);border-radius:var(--r-md);padding:10px 14px;display:flex;flex-direction:column;gap:6px">
              ${r.nhatKy.map(n => `
                <div style="font-size:12px;color:var(--text-secondary)">
                  <span style="color:var(--text-muted)">${dt(n.ThoiGian)}</span> — 
                  <b>${esc(n.HanhDong)}:</b> ${esc(n.NoiDung || '')}
                </div>
              `).join('')}
            </div>
          </div>
        ` : ''}
      `;

      // Drawer Footer & Checkout Calculation
      const tongTien = Number(h.TongTien) || 0;
      const giamGiaPercent = Number(h.GiamGia) || 0;
      const daThanhToan = Number(h.ThanhToan) || 0;
      const tienGiam = Math.round(tongTien * giamGiaPercent / 100);
      const phaiTra = isOpen ? Math.max(0, tongTien - tienGiam) : daThanhToan;

      $('#d-foot').innerHTML = `
        <div class="bill-breakdown">
          <div class="bill-row">
            <span>Tổng tiền hàng</span>
            <span class="tabular">${fmt(tongTien)}</span>
          </div>

          ${!isOpen ? `
            <div class="bill-row">
              <span>Chiết khấu (${giamGiaPercent}%)</span>
              <span class="tabular" style="color:var(--status-bad)">- ${fmt(tongTien - daThanhToan)}</span>
            </div>
            <div class="bill-row grand-total">
              <span>Đã thanh toán (${esc(h.PhuongThucTT || 'Tiền mặt')})</span>
              <span class="amount tabular">${fmt(daThanhToan)}</span>
            </div>
          ` : `
            <div class="bill-row" style="align-items:center">
              <span>Giảm giá (%)</span>
              <div class="discount-chips-row">
                ${[0, 5, 10, 15, 20].map(p => `
                  <button type="button" class="disc-btn ${giamGiaPercent === p ? 'active' : ''}" onclick="window.app.setDiscount(${p})">
                    ${p}%
                  </button>
                `).join('')}
                <input type="number" id="d-gg" value="${giamGiaPercent}" min="0" max="100" class="input-box"
                  style="width:64px;padding:4px 6px;font-size:12px" onchange="window.app.recalcTotal()">
              </div>
            </div>

            <div class="bill-row grand-total">
              <span>Khách phải trả</span>
              <span class="amount tabular" id="d-phai-tra">${fmt(phaiTra)}</span>
            </div>

            <div class="payment-actions-bar" style="margin-top:14px">
              <div style="display:flex;gap:10px;align-items:center">
                <select id="d-pt" class="input-box" style="flex:1">
                  <option value="Tiền mặt">💵 Tiền mặt</option>
                  <option value="Chuyển khoản">📱 Chuyển khoản (QR / Banking)</option>
                  <option value="Thẻ">💳 Quẹt thẻ (POS / Credit)</option>
                </select>
                <button class="btn accent lg shimmer" onclick="window.app.thanhToan()" ${r.chiTiet.length ? '' : 'disabled'} style="flex:1">
                  Thanh toán ngay
                </button>
              </div>

              <div style="display:flex;justify-content:space-between">
                <button class="btn ghost danger sm" onclick="window.app.huyHoaDon()">
                  ${ICONS.trash} Hủy hóa đơn
                </button>
              </div>
            </div>
          `}
        </div>
      `;

      $('#drawer-backdrop').classList.add('show');
      $('#pos-drawer').classList.add('show');

      // Stagger animate ticket rows
      if (window.anime) {
        anime({
          targets: '.ticket-row',
          translateX: [16, 0],
          opacity: [0, 1],
          duration: 300,
          delay: anime.stagger(25),
          easing: 'easeOutQuint'
        });
      }

    } catch (err) {
      toast(err.message, true);
    }
  }

  function closeDrawer() {
    $('#drawer-backdrop').classList.remove('show');
    $('#pos-drawer').classList.remove('show');
  }

  function setDiscount(percent) {
    const input = $('#d-gg');
    if (input) {
      input.value = percent;
      $$('.disc-btn').forEach(btn => btn.classList.toggle('active', btn.textContent.trim() === percent + '%'));
      recalcTotal();
    }
  }

  function recalcTotal() {
    if (!CUR_HD) return;
    const tongTien = Number(CUR_HD.hoaDon.TongTien) || 0;
    const giam = Number($('#d-gg')?.value) || 0;
    const phaiTra = Math.max(0, tongTien - Math.round(tongTien * giam / 100));
    const label = $('#d-phai-tra');
    if (label) {
      label.textContent = fmt(phaiTra);
      if (window.anime) {
        anime({
          targets: label,
          scale: [1.12, 1],
          duration: 250,
          easing: 'easeOutElastic(1, 0.7)'
        });
      }
    }
  }

  async function themMon() {
    if (!CUR_HD) return;
    try {
      const maMon = Number($('#d-mon').value);
      const soLuong = Number($('#d-sl').value);
      await api(`/hoadon/${CUR_HD.hoaDon.MaHD}/mon`, {
        method: 'POST',
        body: { maMon, soLuong }
      });
      toast('Đã gọi thêm món thành công');
      await openDrawer(CUR_HD.hoaDon.MaHD);
      await loadBan();
    } catch (err) {
      toast(err.message, true);
    }
  }

  async function xoaMon(maMon) {
    if (!confirm('Bạn có chắc muốn xóa món này khỏi hóa đơn? Số lượng nguyên liệu tương ứng sẽ được hoàn lại vào kho.')) return;
    try {
      await api(`/hoadon/${CUR_HD.hoaDon.MaHD}/mon/${maMon}`, {
        method: 'DELETE'
      });
      toast('Đã xóa món khỏi hóa đơn');
      await openDrawer(CUR_HD.hoaDon.MaHD);
      await loadBan();
    } catch (err) {
      toast(err.message, true);
    }
  }

  async function thanhToan() {
    if (!CUR_HD) return;
    try {
      const phuongThuc = $('#d-pt').value;
      const giamGia = $('#d-gg').value;
      const res = await api(`/hoadon/${CUR_HD.hoaDon.MaHD}/thanhtoan`, {
        method: 'POST',
        body: { phuongThuc, giamGia }
      });
      toast('Đã thanh toán thành công ' + fmt(res.soTienPhaiTra));
      closeDrawer();
      await loadBan();
    } catch (err) {
      toast(err.message, true);
    }
  }

  async function huyHoaDon() {
    if (!CUR_HD) return;
    const lyDo = prompt('Nhập lý do hủy hóa đơn này:');
    if (lyDo === null) return;
    try {
      await api(`/hoadon/${CUR_HD.hoaDon.MaHD}/huy`, {
        method: 'POST',
        body: { lyDo: lyDo.trim() || 'Hủy theo yêu cầu' }
      });
      toast('Đã hủy hóa đơn');
      closeDrawer();
      await loadBan();
    } catch (err) {
      toast(err.message, true);
    }
  }

