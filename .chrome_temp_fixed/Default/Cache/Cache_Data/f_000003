  let ALL_DATBAN = [];
  async function loadDatBan() {
    try {
      if (!ALL_DATBAN.length) {
        renderTableSkeleton('#datban-table', 7, 6);
      }
      ALL_DATBAN = await api('/datban');
      renderDatBan();
