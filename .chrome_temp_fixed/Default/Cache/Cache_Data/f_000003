              <div style="font-weight:600;display:flex;align-items:center;gap:6px">
                ${x.SapHet ? '<span class="tag bad" style="padding:1px 6px;font-size:11px">Sắp hết</span>' : ''}
                <span style="color:var(--green-950)">${esc(x.TenNL)}</span>
              </div>
            </td>
            <td class="num">
              <b style="color:${x.SapHet ? 'var(--status-bad)' : 'var(--green-700)'}">
                ${num(x.SoLuongTon)} ${x.DonViTinh}
              </b>
            </td>
            <td class="num">${num(x.MucToiThieu)} ${x.DonViTinh}</td>
            <td class="num tabular">${fmt(x.DonGiaNhap)}</td>
            <td>
              <div style="display:flex;gap:6px;align-items:center">
                <input type="number" id="nk-${x.MaNL}" placeholder="SL" min="0.1" step="0.5" class="input-box" style="width:84px;padding:5px 8px">
                <button class="btn sm primary" onclick="window.app.nhapKho(${x.MaNL})">
                  ${ICONS.plus} Nhập
                </button>
              </div>
            </td>
          </tr>
        `).join('')}
      </tbody>
    `;
  }

  async function nhapKho(id) {
    const input = $('#nk-' + id);
    const sl = input ? input.value : null;
    if (!sl || Number(sl) <= 0) return toast('Vui lòng nhập số lượng hợp lệ', true);

    try {
      await api(`/nguyenlieu/${id}/nhap`, {
        method: 'POST',
        body: { soLuong: Number(sl) }
      });
      toast('Đã nhập kho thành công');
      input.value = '';
      await loadKho();
    } catch (err) {
      toast(err.message, true);
    }
  }

  /* ================= 9. BÁO CÁO THÁNG ================= */
  async function loadBaoCao() {
    try {
      const container = $('#bc-table');
      if (container && !container.children.length) {
        renderTableSkeleton('#bc-table', 7, 6);
      }
      const nam = $('#bc-nam').value || new Date().getFullYear();
      const r = await api('/baocao/thang?nam=' + nam);

      // Render summary KPI
      $('#bc-kpi-summary').innerHTML = `
        <div class="kpi-card c-gold">
          <div class="kpi-top">
            <span class="kpi-label">Tổng doanh thu năm ${r.nam}</span>
            <div class="kpi-icon-box gold">${ICONS.dollar}</div>
          </div>
          <div class="kpi-value tabular" id="bc-rev-val">${fmt(r.tongDoanhThu)}</div>
          <div class="kpi-subtext">
            <span>Dữ liệu từ Stored Procedure sp_BaoCaoDoanhThuTheoThang</span>
          </div>
        </div>
      `;

      const revEl = $('#bc-rev-val');
      if (revEl) animateNumberCounter(revEl, Number(r.tongDoanhThu), true);

      if (!r.thang || !r.thang.length) {
        container.innerHTML = `<tr><td colspan="7" class="empty-state"><p class="empty-state-desc">Không có dữ liệu cho năm ${r.nam}</p></td></tr>`;
        return;
      }

      container.innerHTML = `
        <thead>
          <tr>
            <th>Tháng</th>
            <th class="num">Số hóa đơn</th>
            <th class="num">Tổng tiền hàng</th>
            <th class="num">Tiền giảm giá</th>
            <th class="num">Doanh thu thực tế</th>
            <th class="num">TB / Hóa đơn</th>
            <th class="num">Khách thành viên</th>
          </tr>
        </thead>
        <tbody>
          ${r.thang.map(t => `
            <tr>
              <td><b>Tháng ${t.Thang}</b></td>
              <td class="num">${num(t.SoHoaDon)}</td>
              <td class="num tabular">${fmt(t.TongTienHang)}</td>
              <td class="num tabular" style="color:var(--status-bad)">-${fmt(t.TienGiamGia)}</td>
              <td class="num tabular"><b style="color:var(--gold-700)">${fmt(t.DoanhThu)}</b></td>
              <td class="num tabular">${fmt(t.TrungBinhHoaDon)}</td>
              <td class="num">${t.SoKhachThanhVien}</td>
            </tr>
          `).join('')}
        </tbody>
      `;
    } catch (err) {
      toast(err.message, true);
    }
  }

  /* ================= INITIALIZATION ================= */
  function init() {
    startClock();

    // Setup navigation clicks
    $$('.nav-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const page = btn.dataset.page;
        navigateTo(page);
      });
    });

    // Mobile sidebar toggle button
    const toggleBtn = $('#mobile-menu-toggle');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        $('#sidebar').classList.toggle('mobile-open');
      });
    }

    // Modal backdrop click outside
    const modalBackdrop = $('#modal-backdrop');
    if (modalBackdrop) {
      modalBackdrop.addEventListener('click', e => {
        if (e.target.id === 'modal-backdrop') closeModal();
      });
    }

    // Drawer backdrop click
    const drawerBackdrop = $('#drawer-backdrop');
    if (drawerBackdrop) {
      drawerBackdrop.addEventListener('click', closeDrawer);
    }

    // Refresh button
    const refreshBtn = $('#btn-global-refresh');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        const activePage = $('.page.active')?.id?.replace('page-', '') || 'dashboard';
        if (LOADERS[activePage]) {
          if (window.anime) {
            anime({
              targets: refreshBtn.querySelector('.icon'),
              rotate: '+=360',
              duration: 500,
              easing: 'easeOutQuint'
            });
          }
          LOADERS[activePage]();
        }
      });
    }

    // Expose global methods for inline HTML events
    window.app = {
      navigateTo,
      loadDashboard,
      setZone,
      clickBan,
      openMoHoaDon,
      timKhach,
      selectKhach,
      submitMoHoaDon,
      openDrawer,
      closeDrawer,
      setDiscount,
      recalcTotal,
      themMon,
      xoaMon,
      thanhToan,
      huyHoaDon,
      printReceiptModal,
      loadMenu,
      renderMenu,
      openMonForm,
      luuMon,
      loadDatBan,
      renderDatBan,
      capNhatDB,
      openDatBanForm,
      submitDatBan,
      locNam,
      loadHoaDon,
      loadKhachHang,
      openKhForm,
      submitKh,
      loadKho,
      renderKho,
      nhapKho,
      loadBaoCao,
      openModal,
      closeModal
    };

    // Handle browser hash navigation (back/forward or deep links)
    window.addEventListener('hashchange', () => {
      const p = window.location.hash.slice(1);
      if (p.startsWith('hd-')) {
        const id = p.slice(3);
        navigateTo('ban');
        setTimeout(() => openDrawer(id), 150);
      } else if (p && LOADERS[p]) {
        navigateTo(p);
      }
    });

    // Load initial page from hash or default to dashboard
    const initialHash = window.location.hash.slice(1);
    if (initialHash.startsWith('hd-')) {
      const id = initialHash.slice(3);
      navigateTo('ban');
      setTimeout(() => openDrawer(id), 300);
    } else if (initialHash && LOADERS[initialHash]) {
      navigateTo(initialHash);
    } else {
      loadDashboard();
    }
  }

  document.addEventListener('DOMContentLoaded', init);

})();
