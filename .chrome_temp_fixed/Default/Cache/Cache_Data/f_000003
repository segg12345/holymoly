  const tagTT = tt => ({
    'Trống': 'ok',
    'Đang phục vụ': 'busy',
    'Đã đặt': 'book',
    'Đã thanh toán': 'ok',
    'Đã hủy': 'bad',
    'Chờ xác nhận': 'grey',
    'Đã xác nhận': 'book',
    'Đã đến': 'ok',
    'Kim cương': 'vip',
    'Vàng': 'busy',
    'Bạc': 'grey',
    'Thành viên': 'ok'
  }[tt] || 'grey');

  const tag = tt => `<span class="tag ${tagTT(tt)}">${esc(tt)}</span>`;

