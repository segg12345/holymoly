# Sao chép thành .env rồi sửa cho đúng máy của bạn
DB_SERVER=localhost
# Dùng named instance (SQL Server Express mặc định) -> điền SQLEXPRESS; nếu dùng port 1433 cố định thì để trống
PORT=3000
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=QuanLyNhaHang
DB_USER=your_database_user
DB_PASSWORD=your_password_here
DB_ENCRYPT=false
SESSION_SECRET=replace_with_random_secret
