# =====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO SEN VÀNG POS (WEB API)
# Sao chép file này thành .env trong thư mục web/ và cấu hình theo máy
# =====================================================================

PORT=3000

# Kết nối SQL Server
DB_SERVER=localhost
# Nếu dùng named instance (SQLEXPRESS): để trống DB_PORT hoặc cấu hình đúng cổng TCP/IP
# DB_INSTANCE=SQLEXPRESS
DB_PORT=1433
DB_NAME=QuanLyNhaHang
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Bảo mật phiên làm việc
SESSION_SECRET=replace_with_random_secret_string
